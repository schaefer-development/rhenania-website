{
	"name": "code",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"codegen": "graphql-codegen --config codegen.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.2.7",
		"@graphcms/rich-text-html-renderer": "^0.3.1",
		"@graphql-codegen/cli": "6.3.0",
		"@graphql-codegen/introspection": "5.0.2",
		"@graphql-codegen/typescript": "5.0.10",
		"@graphql-codegen/typescript-resolvers": "5.1.8",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.8"
	},
	"dependencies": {
		"@fontsource/red-hat-text": "^5.2.8",
		"@splidejs/svelte-splide": "^0.2.9",
		"@types/nodemailer": "^8.0.0",
		"algoliasearch": "^5.50.2",
		"graphql": "^16.13.2",
		"hcaptcha": "^0.2.0",
		"leaflet": "^1.9.4",
		"nodemailer": "^8.0.5"
	}
}
